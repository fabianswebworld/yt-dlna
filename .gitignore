# ==============================================================================
# yt-dlna .gitignore
# ==============================================================================

# --- user configuration ---
yt-dlna.conf

# --- local data & sensitive files ---
data/

# --- python bytecode & cache ---
__pycache__/
*.py[codz]
*$py.class

# --- environments ---
.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- operating system & IDE artifacts ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- log files ---
*.log
